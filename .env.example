# ---------------------------------------------------------------------------
# KINDLY environment template — NEVER commit real values.
# Copy to `.env.local` and fill in from your Supabase project settings.
# ---------------------------------------------------------------------------

# Which backend the frontend talks to.
#   supabase = real Supabase project (production / staging / local CLI stack)
#   memory   = deterministic in-process backend used by tests and offline demos
VITE_KINDLY_BACKEND=supabase

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# For the local CLI stack this is http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe to ship to browsers *only* because
# Row Level Security is enabled on every table (see supabase/migrations).
VITE_SUPABASE_ANON_KEY=

# Where Supabase should send users after a password-reset or verification email.
# Must be listed in Authentication > URL Configuration > Redirect URLs.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Optional: show the "demo family" seeding control in non-production builds.
VITE_KINDLY_ALLOW_DEMO_SEED=false

# ---------------------------------------------------------------------------
# Server-side only (Supabase Edge Functions). Set with `supabase secrets set`.
# These must NOT be prefixed with VITE_ and must never reach the browser.
# ---------------------------------------------------------------------------
# Required by the generate-story Edge Function. Without it, story generation
# reports itself unavailable and the app falls back to its built-in builder.
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=
#
# Optional. Defaults to claude-opus-5.
# KINDLY_STORY_MODEL=claude-opus-5
#
# Optional. Locks the function's CORS origin to your site instead of "*".
# KINDLY_ALLOWED_ORIGIN=https://your-domain
