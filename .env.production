# ---------------------------------------------------------------------------
# Production build values for KINDLY.
#
# These are committed on purpose. Both values are *publishable*: Vite inlines
# them into the JavaScript that every visitor downloads, so they are public the
# moment the site is served, whether or not they live in this file. Keeping
# them here makes the build reproducible from a clone and independent of any
# dashboard setting.
#
# The anon key is safe ONLY because Row Level Security is enabled AND forced on
# every table and all privileges are revoked from the anon role
# (see supabase/migrations/*_rls.sql). It is not a secret, and it is not a
# permission. The service_role key is the opposite of both and must never
# appear in this repository, this file, or any VITE_ variable.
# ---------------------------------------------------------------------------

VITE_KINDLY_BACKEND=supabase
VITE_SUPABASE_URL=https://umqfphjcyrytsbidrzoj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVtcWZwaGpjeXJ5dHNiaWRyem9qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc3NzYwMjksImV4cCI6MjEwMzM1MjAyOX0.WR3DfiqAet2HM0NnLk8NiJwd302KazlC6eRYqfk4Jv8
VITE_PUBLIC_SITE_URL=https://kindlyapp.vercel.app
VITE_KINDLY_ALLOW_DEMO_SEED=false
