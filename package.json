{
  "name": "kindly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KINDLY — a calm autism-support space for children and their caregivers.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:seed": "supabase db reset --no-backup",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.2",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "supabase": "^2.116.0",
    "typescript": "^5.6.2",
    "vercel": "^59.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
